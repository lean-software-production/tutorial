#!/bin/sh
# A reviewer that is never satisfied, with a numbered finding: "report 1",
# "report 2" and so on, counted in $STAND_IN_STATE, so a check can tell
# reports apart.
. "$(dirname "$0")/_read-prompt.sh"
state="${STAND_IN_STATE:-${TMPDIR:-/tmp}/stand-in-state}"
mkdir -p "$state"
while ! mkdir "$state/numbered-report.lock" 2>/dev/null; do sleep 0.05; done
n=$(( $(cat "$state/numbered-report" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$state/numbered-report"
rmdir "$state/numbered-report.lock"
printf '{"satisfied": false, "findings": ["report %s"]}\n' "$n"
