#!/bin/sh
# A doer that follows the steps written in its task. It takes the first
# task in the plan that is not ticked and reads it as steps separated by
# ";":
#
#   say <text>              print <text>, as a line it generates
#   sleep <seconds>         wait
#   read <skill>            read that skill's SKILL.md, whose path the
#                           prompt names (under the ACP wrapper, a read)
#   run <command>           ask to run <command> (under the ACP wrapper,
#                           through the factory's run_command tool)
#   on attempt <n>: <step>  do <step> only on this task's nth attempt
#
# After each step it prints any message it has heard. Then it does the
# task, and its result names it. It never touches the plan.
. "$(dirname "$0")/_read-prompt.sh"
. "$(dirname "$0")/_plan.sh"
task=$( [ -f "$plan_path" ] && first_unticked )
if [ -z "$task" ]; then echo '{"task": null}'; exit 0; fi
state="${STAND_IN_STATE:-${TMPDIR:-/tmp}/stand-in-state}"
mkdir -p "$state"
counter="$state/scripted-$(work_file "$task")"
attempt=$(( $(cat "$counter" 2>/dev/null || echo 0) + 1 ))
echo "$attempt" > "$counter"
printf '%s\n' "$task" | tr ';' '\n' | while IFS= read -r step; do
  step=$(printf '%s' "$step" | sed 's/^ *//; s/ *$//')
  case "$step" in
    "on attempt "*:*)
      n=${step#on attempt }; n=${n%%:*}
      [ "$n" = "$attempt" ] || continue
      step=$(printf '%s' "${step#*:}" | sed 's/^ *//') ;;
  esac
  case "$step" in
    "say "*) printf '%s\n' "${step#say }" ;;
    "sleep "*) sleep "${step#sleep }" ;;
    "read "*)
      skill=${step#read }
      path=$(printf '%s\n' "$prompt" | grep -o "[^][[:space:]\`\"'()<>]*/$skill/SKILL\.md" | head -n 1)
      [ -n "$path" ] && echo "@read $path" ;;
    "run "*) echo "@run ${step#run }" ;;
  esac
  hear
done
do_task "$task"
printf '{"task": %s}\n' "$(json_string "$task")"
