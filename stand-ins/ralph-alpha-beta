#!/bin/sh
# A whole Ralph loop's agent in one call. With no plan, writes one: alpha,
# then beta. Otherwise does the first task not ticked and ticks it. Its
# result says whether the plan is complete.
. "$(dirname "$0")/_read-prompt.sh"
. "$(dirname "$0")/_plan.sh"
if [ -z "$plan_path" ]; then echo '{"complete": false}'; exit 0; fi
if [ ! -f "$plan_path" ]; then write_new_plan; echo '{"complete": false}'; exit 0; fi
task=$(first_unticked)
if [ -z "$task" ]; then echo '{"complete": true}'; exit 0; fi
do_task "$task"
tick "$task"
printf '{"complete": false, "task": %s}\n' "$(json_string "$task")"
