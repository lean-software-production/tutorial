#!/bin/sh
# A planner. With no plan, writes one: alpha, then beta. With a plan, ticks
# every task whose work is committed. Its result says whether the plan is
# complete.
. "$(dirname "$0")/_read-prompt.sh"
. "$(dirname "$0")/_plan.sh"
if [ -z "$plan_path" ]; then echo '{"complete": false}'; exit 0; fi
if [ ! -f "$plan_path" ]; then write_new_plan; echo '{"complete": false}'; exit 0; fi
tasks=$(unticked)
printf '%s\n' "$tasks" | while IFS= read -r task; do
  [ -n "$task" ] && is_committed "$task" && tick "$task"
done
if [ -z "$(first_unticked)" ]; then echo '{"complete": true}'; else echo '{"complete": false}'; fi
